local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")

-- Cài đặt
local BOSS_NAME = "Boss" -- Đổi theo tên Model Boss trong Workspace
local HOVER_HEIGHT = 20
local CLICK_DELAY = 0.2
local AUTO_ENABLED = false

-- UI Toggle
local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "AutoAttackUI"

local toggleBtn = Instance.new("TextButton", screenGui)
toggleBtn.Size = UDim2.new(0, 150, 0, 40)
toggleBtn.Position = UDim2.new(0, 20, 0.8, 0)
toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.Font = Enum.Font.GothamBlack
toggleBtn.TextSize = 18
toggleBtn.Text = "Auto: Tắt"

-- Auto Click Function
local function autoClick()
    while AUTO_ENABLED do
        local tool = player.Character:FindFirstChildOfClass("Tool")
        if tool and tool:FindFirstChild("Activate") then
            tool:Activate()
        end
        wait(CLICK_DELAY)
    end
end

-- Auto Follow + Attack
RS.RenderStepped:Connect(function()
    if not AUTO_ENABLED then return end

    local boss = workspace:FindFirstChild(BOSS_NAME)
    if boss and boss:FindFirstChild("HumanoidRootPart") then
        -- Equip vũ khí slot 1
        local tool = player.Backpack:FindFirstChildOfClass("Tool")
        if tool then
            tool.Parent = player.Character
        end

        -- Bay trên đầu boss
        local targetPos = boss.HumanoidRootPart.Position + Vector3.new(0, HOVER_HEIGHT, 0)
        hrp.CFrame = CFrame.new(targetPos)

        -- Auto Click nếu gần
        if (hrp.Position - boss.HumanoidRootPart.Position).Magnitude <= HOVER_HEIGHT + 10 then
            -- đảm bảo đang auto click
            task.spawn(autoClick)
        end
    end
end)

-- UI Toggle Control
toggleBtn.MouseButton1Click:Connect(function()
    AUTO_ENABLED = not AUTO_ENABLED
    toggleBtn.Text = AUTO_ENABLED and "Auto: Bật" or "Auto: Tắt"
    toggleBtn.BackgroundColor3 = AUTO_ENABLED and Color3.fromRGB(60, 180, 80) or Color3.fromRGB(30, 30, 30)
end)
