-- Load Orion Library
local OrionLib = loadstring(game:HttpGet(('https://raw.githubusercontent.com/shlexware/Orion/main/source')))()

-- Biến toàn cục
local isPaid = false
local player = game.Players.LocalPlayer
local flyEnabled = false
local vehicleFlyEnabled = false
local vehicleNoclipEnabled = false
local fullbrightEnabled = false
local bodyVelocityFly, bodyAngularVelocityFly = nil, nil
local bodyVelocityVehicle, bodyAngularVelocityVehicle = nil, nil

-- Function check key từ Pastebin
local function checkKey(inputKey)
    local success, result = pcall(function()
        local pastebinUrl = "https://pastebin.com/raw/YourPastebinID"  -- Thay bằng link Pastebin raw của bạn (ví dụ: https://pastebin.com/raw/abc123)
        local validKey = game:HttpGet(pastebinUrl)
        return inputKey == validKey:gsub("%s+", "")  -- So sánh key (bỏ khoảng trắng)
    end)
    return success and result or false
end

-- Function chung để check premium trước khi thực thi (cho free: block non-lighting)
local function requirePremium(featureName)
    if not isPaid then
        OrionLib:MakeNotification({
            Name = "Premium Required",
            Content = "Buy premium key to use " .. featureName .. "! (Free version limited to Lighting features)",
            Image = "rbxassetid://4483345998",
            Time = 5
        })
        return false
    end
    return true
end

-- Implement Fly / UnFly (từ Infinite Yield)
local function enableFly()
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        flyEnabled = true
        bodyVelocityFly = Instance.new("BodyVelocity")
        bodyVelocityFly.MaxForce = Vector3.new(4000, 4000, 4000)
        bodyVelocityFly.Velocity = Vector3.new(0, 0, 0)
        bodyVelocityFly.Parent = root

        bodyAngularVelocityFly = Instance.new("BodyAngularVelocity")
        bodyAngularVelocityFly.MaxTorque = Vector3.new(4000, 4000, 4000)
        bodyAngularVelocityFly.AngularVelocity = Vector3.new(0, 0, 0)
        bodyAngularVelocityFly.Parent = root

        spawn(function()
            while flyEnabled do
                local camera = workspace.CurrentCamera
                local direction = camera.CFrame.LookVector
                local speed = 50  -- Tốc độ mặc định
                if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift) then
                    speed = speed * 2
                end
                bodyVelocityFly.Velocity = direction * speed
                wait()
            end
        end)
        print("Fly enabled!")
    end
end

local function disableFly()
    flyEnabled = false
    if bodyVelocityFly then bodyVelocityFly:Destroy() end
    if bodyAngularVelocityFly then bodyAngularVelocityFly:Destroy() end
    print("Fly disabled!")
end

-- Implement VehicleFly / UnVehicleFly (từ Infinite Yield)
local function enableVehicleFly()
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        local seat = root:FindFirstChildOfClass("VehicleSeat")
        if seat then
            vehicleFlyEnabled = true
            bodyVelocityVehicle = Instance.new("BodyVelocity")
            bodyVelocityVehicle.MaxForce = Vector3.new(4000, 4000, 4000)
            bodyVelocityVehicle.Velocity = Vector3.new(0, 0, 0)
            bodyVelocityVehicle.Parent = seat

            bodyAngularVelocityVehicle = Instance.new("BodyAngularVelocity")
            bodyAngularVelocityVehicle.MaxTorque = Vector3.new(4000, 4000, 4000)
            bodyAngularVelocityVehicle.AngularVelocity = Vector3.new(0, 0, 0)
            bodyAngularVelocityVehicle.Parent = seat

            spawn(function()
                while vehicleFlyEnabled do
                    local camera = workspace.CurrentCamera
                    local direction = camera.CFrame.LookVector
                    local speed = 50  -- Tốc độ mặc định
                    if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift) then
                        speed = speed * 2
                    end
                    bodyVelocityVehicle.Velocity = direction * speed
                    wait()
                end
            end)
            print("Vehicle Fly enabled!")
        end
    end
end

local function disableVehicleFly()
    vehicleFlyEnabled = false
    if bodyVelocityVehicle then bodyVelocityVehicle:Destroy() end
    if bodyAngularVelocityVehicle then bodyAngularVelocityVehicle:Destroy() end
    print("Vehicle Fly disabled!")
end

-- Implement VehicleNoclip / VehicleClip (từ Infinite Yield)
local function enableVehicleNoclip()
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        local seat = root:FindFirstChildOfClass("VehicleSeat")
        if seat then
            vehicleNoclipEnabled = true
            spawn(function()
                while vehicleNoclipEnabled do
                    for _, part in pairs(character:GetDescendants()) do
                        if part:IsA("BasePart") and part ~= root then
                            part.CanCollide = false
                        end
                    end
                    wait()
                end
            end)
            print("Vehicle Noclip enabled!")
        end
    end
end

local function disableVehicleNoclip()
    vehicleNoclipEnabled = false
    local character = player.Character
    if character then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
    print("Vehicle Noclip disabled!")
end

-- Implement LoopFullBright / NoFog (từ Infinite Yield) - Luôn hoạt động
local function enableLoopFullBright()
    fullbrightEnabled = true
    spawn(function()
        while fullbrightEnabled do
            game.Lighting.Brightness = 1
            game.Lighting.FogEnd = 100000
            game.Lighting.GlobalShadows = false
            game.Lighting.FogStart = 0
            wait()
        end
    end)
    print("Loop FullBright enabled!")
end

local function disableLoopFullBright()
    fullbrightEnabled = false
    -- Khôi phục mặc định
    game.Lighting.Brightness = 2
    game.Lighting.FogEnd = 100000
    game.Lighting.GlobalShadows = true
    print("Loop FullBright disabled!")
end

local function noFog()
    game.Lighting.FogEnd = 100000
    game.Lighting.FogStart = 0
    print("Fog disabled!")
end

