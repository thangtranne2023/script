local player = game.Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")
local RS = game:GetService("RunService")

local AUTO_ENABLED = false
local HOVER_HEIGHT = 20
local CLICK_DELAY = 0.15

-- UI
local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "MobAttackUI"

local toggleBtn = Instance.new("TextButton", screenGui)
toggleBtn.Size = UDim2.new(0, 160, 0, 40)
toggleBtn.Position = UDim2.new(0, 20, 0.85, 0)
toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 18
toggleBtn.Text = "Auto Mob: Tắt"

-- Tìm mob gần nhất
local function getNearestMob()
    local closest
    local dist = math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") and obj ~= char then
            local d = (hrp.Position - obj.HumanoidRootPart.Position).Magnitude
            if d < dist then
                closest = obj
                dist = d
            end
        end
    end
    return closest
end

-- Click Tool
local function autoClick()
    while AUTO_ENABLED do
        local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
        task.wait(CLICK_DELAY)
    end
end

-- Bay & tấn công
RS.RenderStepped:Connect(function()
    if not AUTO_ENABLED then return end
    local mob = getNearestMob()
    if mob then
        -- Equip
        local tool = player.Backpack:FindFirstChildOfClass("Tool")
        if tool then tool.Parent = player.Character end

        -- Hover
        local pos = mob.HumanoidRootPart.Position + Vector3.new(0, HOVER_HEIGHT, 0)
        hrp.CFrame = CFrame.new(pos)

        -- Auto click
        if (hrp.Position - mob.HumanoidRootPart.Position).Magnitude <= HOVER_HEIGHT + 10 then
            task.spawn(autoClick)
        end
    end
end)

-- Toggle UI
toggleBtn.MouseButton1Click:Connect(function()
    AUTO_ENABLED = not AUTO_ENABLED
    toggleBtn.Text = AUTO_ENABLED and "Auto Mob: Bật" or "Auto Mob: Tắt"
    toggleBtn.BackgroundColor3 = AUTO_ENABLED and Color3.fromRGB(40, 180, 80) or Color3.fromRGB(30, 30, 30)
end)
