    Default = "",
    TextDisappear = false,
    Callback = function(Value)
        -- Chỉ input
    end
})

-- Verify Button
local VerifyButton = KeyTab:AddButton({
    Name = "Verify Key",
    Callback = function()
        local inputKey = KeyTextbox.Value
        if inputKey == "" then
            OrionLib:MakeNotification({
                Name = "Error",
                Content = "Please enter a key!",
                Image = "rbxassetid://4483345998",
                Time = 3
            })
            return
        end
        
        OrionLib:MakeNotification({
            Name = "Checking...",
            Content = "Verifying your key...",
            Image = "rbxassetid://4483345998",
            Time = 2
        })
        
        local keyValid = checkKey(inputKey)
        
        if keyValid then
            isPaid = true
            OrionLib:MakeNotification({
                Name = "Success",
                Content = "Paid Full Version unlocked! Loading all features.",
                Image = "rbxassetid://4483345998",
                Time = 5
            })
            KeyWindow:Destroy()
            loadMainUI(true)
        else
            isPaid = false
            OrionLib:MakeNotification({
                Name = "Invalid Key",
                Content = "Invalid key! Loading Free version (Full UI, but limited to Lighting).",
                Image = "rbxassetid://4483345998",
                Time = 5
            })
            wait(3)
            KeyWindow:Destroy()
            loadMainUI(false)
        end
    end
})

