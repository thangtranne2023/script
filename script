-- Twisted Beta Hub - Key Auth + Full Features
print("Twisted Beta Hub - Loading...")

local OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Orion/main/source'))()
local HttpService = game:GetService("HttpService")
local player = game.Players.LocalPlayer

-- === LẤY KEY TỪ getgenv() ===
local INPUT_KEY = getgenv().Key or ""
if INPUT_KEY == "" then
    warn("No key provided!")
    return
end

-- === LẤY IP ===
local function getIP()
    local success, res = pcall(function()
        return game:HttpGet("https://httpbin.org/ip")
    end)
    if success then
        return res:match('"origin":"([^"]+)"') or "Unknown"
    end
    return "Unknown"
end

-- === CHECK KEY + LOG IP ===
local function verifyKey()
    local ip = getIP()
    local log = HttpService:JSONEncode({
        key = INPUT_KEY,
        ip = ip,
        user = player.Name,
        time = os.date("%Y-%m-%d %H:%M:%S")
    })
    pcall(function()
        HttpService:PostAsync("https://canary.discord.com/api/webhooks/1434894853405409320/X0dIkVmMi10yDBjOR7Mf73S8m6EFkopW28wKvjXy0EmArHQVo69Yne-vIRtce1-o1HBU", log, Enum.HttpContentType.ApplicationJson)
    end)

    local validKey = game:HttpGet("https://hastebin.com/raw/" .. INPUT_KEY:sub(1,8)):gsub("%s+", "")
    return INPUT_KEY == validKey
end

if not verifyKey() then
    OrionLib:MakeNotification({Name = "Access Denied", Content = "Invalid key!", Time = 5})
    return
end

OrionLib:MakeNotification({Name = "Success", Content = "Key verified! Unlocking...", Time = 3})

-- === [1] BYPASS ANTICHEAT ===
local function bypass()
    local rs = game:GetService("ReplicatedStorage")
    local events = rs:FindFirstChild("events")
    if events and events:FindFirstChild("plr_examine") then
        events.plr_examine:Destroy()
        OrionLib:MakeNotification({Name = "Bypass", Content = "Anticheat disabled!", Time = 3})
    end
end

-- === [2] LOOP FULLBRIGHT ===
local fb = false
local function toggleFB(v)
    fb = v
    spawn(function()
        while fb do
            game.Lighting.Brightness = 2
            game.Lighting.FogEnd = 999999
            game.Lighting.GlobalShadows = false
            for _, v in pairs(game.Lighting:GetChildren()) do
                if v:IsA("PostEffect") then v.Enabled = false end
            end
            wait(0.1)
        end
    end)
end

-- === [3] FLY CAR ===
local flying = false
local speed = 50
local bv, bg = nil, nil
local function flyCar()
    local char = player.Character or player.CharacterAdded:Wait()
    local hum = char:FindFirstChild("Humanoid")
    if not hum or not hum.SeatPart then return end
    local vehicle = hum.SeatPart.Parent
    local root = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
    if not root then return end

    flying = true
    bv = Instance.new("BodyVelocity", root)
    bv.MaxForce = Vector3.new(1e5,1e5,1e5)
    bg = Instance.new("BodyGyro", root)
    bg.MaxTorque = Vector3.new(1e5,1e5,1e5)
    bg.P = 10000

    spawn(function()
        while flying do
            local cam = workspace.CurrentCamera
            local move = Vector3.new(
                (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) and 1 or 0),
                (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftControl) and 1 or 0),
                (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) and 1 or 0)
            )
            if move.Magnitude > 0 then
                move = move.unit * speed
                bv.Velocity = (cam.CFrame.RightVector * move.X) + (Vector3.new(0,1,0) * move.Y) + (cam.CFrame.LookVector * move.Z)
            else
                bv.Velocity = Vector3.new(0,0,0)
            end
            bg.CFrame = cam.CFrame
            wait()
        end
    end)
end
local function stopFly()
    flying = false
    if bv then bv:Destroy() end
    if bg then bg:Destroy() end
end

-- === UI ===
local Window = OrionLib:MakeWindow({Name = "Twisted Beta Hub", SaveConfig = true})
local Tab = Window:MakeTab({Name = "Main"})

Tab:AddButton({Name = "Bypass Anticheat", Callback = bypass})
Tab:AddToggle({Name = "Loop FullBright", Callback = toggleFB})
Tab:AddSlider({Name = "Fly Speed", Min = 10, Max = 300, Default = 50, Callback = function(v) speed = v end})
Tab:AddToggle({Name = "Fly Car (Sit in Vehicle)", Callback = function(v) if v then flyCar() else stopFly() end end})

OrionLib:Init()
print("Twisted Beta Hub - Fully Loaded!")
