function ScriptHub:setupEvents()
    -- Keybind to toggle
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == HubConfig.KeyBind then
            self:toggle()
        end
    end)
end

function ScriptHub:toggle()
    self.isOpen = not self.isOpen
    if self.isOpen then
        self:show()
    else
        self:hide()
    end
end

function ScriptHub:show()
    self.mainFrame.Visible = true
    local tween = TweenService:Create(
        self.mainFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Size = UDim2.new(0, 600, 0, 400)}
    )
    tween:Play()
end

function ScriptHub:hide()
    local tween = TweenService:Create(
        self.mainFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In),
        {Size = UDim2.new(0, 0, 0, 0)}
    )
    tween:Play()
    tween.Completed:Connect(function()
        self.mainFrame.Visible = false
    end)
end

function ScriptHub:addCategory(name, icon)
    local categoryButton = Instance.new("TextButton")
    categoryButton.Name = name .. "Button"
    categoryButton.Size = UDim2.new(1, -10, 0, 35)
    categoryButton.Position = UDim2.new(0, 5, 0, #self.categories * 40 + 5)
    categoryButton.BackgroundColor3 = HubConfig.Theme.Primary
    categoryButton.Text = (icon or "📁") .. " " .. name
    categoryButton.TextColor3 = HubConfig.Theme.Text
    categoryButton.TextSize = 14
    categoryButton.Font = Enum.Font.Gotham
    categoryButton.BorderSizePixel = 0
    categoryButton.Parent = self.sidePanel

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 4)
    buttonCorner.Parent = categoryButton

    -- Store category
    self.categories[name] = {
        button = categoryButton,
        scripts = {}
    }

    -- Click event
    categoryButton.MouseButton1Click:Connect(function()
        self:showCategory(name)
    end)

    return categoryButton
end

function ScriptHub:addScript(categoryName, scriptName, description, callback)
    if not self.categories[categoryName] then
        self:addCategory(categoryName)
    end

    local script = {
        name = scriptName,
        description = description,
        callback = callback
    }

    table.insert(self.categories[categoryName].scripts, script)
end

function ScriptHub:showCategory(categoryName)
    -- Clear content area
    for _, child in pairs(self.contentArea:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local category = self.categories[categoryName]
    if not category then return end

    -- Create script buttons
    for i, script in pairs(category.scripts) do
        local scriptFrame = Instance.new("Frame")
        scriptFrame.Name = script.name .. "Frame"
        scriptFrame.Size = UDim2.new(1, -10, 0, 80)
        scriptFrame.BackgroundColor3 = HubConfig.Theme.Primary
        scriptFrame.BorderSizePixel = 0
        scriptFrame.LayoutOrder = i
        scriptFrame.Parent = self.contentArea

        local frameCorner = Instance.new("UICorner")
        frameCorner.CornerRadius = UDim.new(0, 6)
        frameCorner.Parent = scriptFrame

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, -100, 0, 25)
        nameLabel.Position = UDim2.new(0, 10, 0, 5)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = script.name
        nameLabel.TextColor3 = HubConfig.Theme.Text
        nameLabel.TextSize = 16
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Parent = scriptFrame

        local descLabel = Instance.new("TextLabel")
