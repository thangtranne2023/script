local function getEF(wind)
	if wind >= 201 then
		return "EF5", Color3.fromRGB(180, 0, 0)
	elseif wind >= 166 then
		return "EF4", Color3.fromRGB(220, 50, 50)
	elseif wind >= 136 then
		return "EF3", Color3.fromRGB(255, 85, 0)
	elseif wind >= 111 then
		return "EF2", Color3.fromRGB(255, 170, 0)
	elseif wind >= 86 then
		return "EF1", Color3.fromRGB(255, 215, 0)
	elseif wind >= 65 then
		return "EF0", Color3.fromRGB(130, 200, 40)
	else
		return "Below EF Scale", Color3.fromRGB(60, 60, 60)
	end
end

