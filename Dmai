local function findTornadoWindValue()
	local stormsFolder = workspace:FindFirstChild("storm_related") and workspace.storm_related:FindFirstChild("storms")
	if not stormsFolder then return nil, nil end

	for _, storm in pairs(stormsFolder:GetChildren()) do
		local configs = storm:FindFirstChild("configs")
		local tornado = configs and configs:FindFirstChild("tornado")
		local winds = tornado and tornado:FindFirstChild("winds")
		if winds and winds:IsA("NumberValue") then
			return winds, storm.Name
		end
	end
	return nil, nil
end

