-- Find vehicle logic (unchanged)
local function findVehicle()
    local vehicle = nil
    local playerRelated = Workspace:FindFirstChild("player_related")
    if playerRelated then
        local cars = playerRelated:FindFirstChild("cars")
        if cars then
            vehicle = cars:FindFirstChild(tostring(player.UserId))
            if vehicle then
                updateStatus("Found your car: " .. vehicle.Name, Color3.fromRGB(100, 255, 100))
                return vehicle
            end
        end
    end
    if not vehicle and player:FindFirstChild("Vehicle") then
        vehicle = player.Vehicle
        updateStatus("Found via player.Vehicle", Color3.fromRGB(100, 255, 100))
    end
    if not vehicle and player.Character then
        for _, child in pairs(player.Character:GetChildren()) do
            if child.Name:lower():find("vehicle") or child.Name:lower():find("car") then
                vehicle = child
                updateStatus("Found in character: " .. child.Name, Color3.fromRGB(100, 255, 100))
                break
            end
        end
    end
    if not vehicle and player.Character and player.Character:FindFirstChild("Humanoid") then
        local seat = player.Character.Humanoid.SeatPart
        if seat then
            vehicle = seat.Parent
            updateStatus("Found via seat: " .. vehicle.Name, Color3.fromRGB(100, 255, 100))
        end
    end
    if not vehicle then
        for _, obj in pairs(Workspace:GetChildren()) do
            if (obj.Name:find(player.Name) or obj.Name == tostring(player.UserId)) and 
               (obj.Name:lower():find("vehicle") or obj.Name:lower():find("car") or obj:FindFirstChild("VehicleSeat")) then
                vehicle = obj
                updateStatus("Found in workspace: " .. obj.Name, Color3.fromRGB(100, 255, 100))
                break
            end
        end
    end
    return vehicle
end

-- Speed mod logic
local function applySpeedMod(vehicle)
    if not vehicle then return false end
    local success = false

    for _, obj in pairs(vehicle:GetDescendants()) do
        if obj:IsA("NumberValue") or obj:IsA("IntValue") then
            local name = string.lower(obj.Name)
            if name:find("speed") or name:find("maxspeed") or name:find("topspeed") or 
               name:find("velocity") or name:find("acceleration") or name:find("power") then
                obj.Value = 1000
                success = true
            elseif name:find("force") or name:find("torque") then
                obj.Value = 5000
                success = true
            end
        end
    end

    local primaryPart = vehicle.PrimaryPart or vehicle:FindFirstChild("Main") or vehicle:FindFirstChild("Body") or vehicle:FindFirstChild("Chassis")
    if not primaryPart then
        for _, part in pairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                local size = part.Size.X * part.Size.Y * part.Size.Z
                if not primaryPart or size > (primaryPart.Size.X * primaryPart.Size.Y * primaryPart.Size.Z) then
                    primaryPart = part
                end
            end
        end
    end

    if primaryPart then
        for _, obj in pairs(primaryPart:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyPosition") or obj:IsA("BodyAngularVelocity") then
                obj:Destroy()
            end
        end

        if speedConnection then
            speedConnection:Disconnect()
        end

        speedConnection = RunService.Heartbeat:Connect(function()
            if speedEnabled and vehicle and vehicle.Parent and primaryPart and primaryPart.Parent then
                local velocity = primaryPart.AssemblyLinearVelocity
                local currentSpeed = math.floor(velocity.Magnitude)
                speedLabel.Text = "Speed: " .. currentSpeed

                local maxSpeed = tonumber(speedInput.Text) or 300
                if velocity.Magnitude > 1 then
                    local direction = velocity.Unit
                    local newSpeed = math.min(velocity.Magnitude * 1.05, maxSpeed)
                    primaryPart.AssemblyLinearVelocity = direction * newSpeed
                end
            else
                speedLabel.Text = "Speed: 0"
            end
        end)

        success = true
    end

    return success
end

