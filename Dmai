        local success = applySpeedMod(currentVehicle)
        if success then
            updateStatus("Speed mod ENABLED!", Color3.fromRGB(100, 255, 100))
        else
            updateStatus("Failed to enable speed mod", Color3.fromRGB(255, 100, 100))
            speedEnabled = false
            updateButton()
        end
    else
        updateStatus("Speed mod DISABLED", Color3.fromRGB(255, 200, 100))
        if speedConnection then
            speedConnection:Disconnect()
            speedConnection = nil
        end
    end
end

